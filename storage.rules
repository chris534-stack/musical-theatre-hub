rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Public read access for all files
    match /{allPaths=**} {
      allow read;
    }

    // Allow a user to write (create, update, delete) only to their own folder.
    // The folder name must match their user ID (request.auth.uid).
    match /{userId}/{allPaths=**} {
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
