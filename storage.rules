rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Match any file in a user-specific folder
    match /{userId}/{allPaths=**} {
      // Allow anyone to read files. This is necessary for public profile/gallery images.
      allow read;

      // Allow write operations (create, update, delete) only if the user is authenticated
      // and their UID matches the folder name.
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
